@model IEnumerable<Template>
@{
    ViewData["Title"] = "Templates - E-Greetings";
    var categories = ViewBag.Categories as List<Category>;
    var selectedCategory = ViewBag.SelectedCategory as int?;
}

<section style="padding-top:120px; min-height:80vh; background:#0F0F1A;">
    <div class="container">
        <div class="text-center" data-aos="fade-up">
            <h2 class="section-title">Choose Your <span>Template</span></h2>
            <p class="section-subtitle">Select a template to personalize and send</p>
        </div>

        <!-- Category Filter -->
        <div class="row justify-content-center mb-5">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a asp-action="Index" class="btn @(selectedCategory == null ? "btn-login" : "btn-register")">
                        All
                    </a>
                    @foreach (var cat in categories)
                    {
                        <a asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                           class="btn @(selectedCategory == cat.CategoryId ? "btn-login" : "btn-register")">
                            @cat.Name
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Templates Grid -->
        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @foreach (var template in Model)
                {
                    <div class="col-lg-3 col-md-6" data-aos="fade-up">
                        <div class="category-card" style="padding:20px; cursor:pointer;">
                            <img src="@template.ImagePath" alt="@template.Title"
                                 style="width:100%; height:200px; object-fit:cover; border-radius:15px;"
                                 onerror="this.src='https://via.placeholder.com/300x200/1A1A2E/FFFFFF?text=🎴+Card'" />
                            <h5 class="mt-3" style="color:#FFFFFF;">@template.Title</h5>
                            <p style="color:rgba(255,255,255,0.4); font-size:0.85rem;">
                                @template.Description
                            </p>
                            <p style="color:rgba(255,255,255,0.3); font-size:0.8rem;">
                                <i class="fas fa-tag"></i> @template.Category?.Name
                            </p>
                            <a asp-controller="Template" asp-action="Details" asp-route-id="@template.TemplateId"
                               class="btn btn-login" style="width:100%; margin-top:10px;">
                                <i class="fas fa-eye"></i> Preview
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" style="padding:80px 0;">
                    <i class="fas fa-box-open" style="font-size:4rem; color:rgba(255,255,255,0.1);"></i>
                    <h4 style="color:rgba(255,255,255,0.4); margin-top:20px;">No templates available</h4>
                    <p style="color:rgba(255,255,255,0.2);">Check back later for new templates</p>
                </div>
            }
        </div>
    </div>
</section>
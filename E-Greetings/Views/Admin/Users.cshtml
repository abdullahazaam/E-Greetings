@model IEnumerable<UserRoleViewModel>
@{
    ViewData["Title"] = "Manage Users - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .admin-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .action-btn {
        padding: 5px 12px;
        border: none;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        margin: 2px;
        text-decoration: none;
        display: inline-block;
    }

        .action-btn:hover {
            transform: translateY(-1px);
        }

    .btn-edit {
        background: #6C63FF;
        color: #FFFFFF;
    }

        .btn-edit:hover {
            background: #5a52d6;
            color: #FFFFFF;
        }

    .btn-delete {
        background: #FF6B6B;
        color: #FFFFFF;
    }

        .btn-delete:hover {
            background: #e55a5a;
            color: #FFFFFF;
        }

    .btn-make-admin {
        background: #FFD93D;
        color: #1A1A2E;
    }

        .btn-make-admin:hover {
            background: #f0cc2a;
            color: #1A1A2E;
        }

    .btn-remove-admin {
        background: #FFA94D;
        color: #1A1A2E;
    }

        .btn-remove-admin:hover {
            background: #f0983a;
            color: #1A1A2E;
        }

    .badge-admin {
        background: #6C63FF;
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        color: #FFFFFF;
        font-weight: 600;
    }

    .badge-user {
        background: rgba(255,255,255,0.15);
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        color: rgba(255,255,255,0.6);
        font-weight: 600;
    }

    .badge-active {
        background: #4CAF50;
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        color: #FFFFFF;
        font-weight: 600;
    }

    .badge-inactive {
        background: #FF6B6B;
        padding: 4px 14px;
        border-radius: 50px;
        font-size: 0.75rem;
        color: #FFFFFF;
        font-weight: 600;
    }

    .alert-error {
        background: rgba(255,107,107,0.15);
        border: 1px solid #FF6B6B;
        color: #FF6B6B;
        border-radius: 12px;
        padding: 12px 20px;
    }
</style>

<section class="admin-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF; margin-bottom:0;">
                    Manage <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Users</span>
                </h2>
                <p style="color:rgba(255,255,255,0.4);">Manage user accounts, roles and permissions</p>
            </div>
            <div>
                <span class="badge-admin" style="font-size:1rem; padding:8px 20px;">
                    <i class="fas fa-users"></i> Total: @Model.Count()
                </span>
                <a asp-action="Dashboard" class="btn btn-register" style="text-decoration:none; padding:10px 30px; border:2px solid rgba(255,255,255,0.2); border-radius:50px; color:#FFFFFF; background:transparent; display:inline-block; margin-left:10px;">
                    <i class="fas fa-home"></i> Dashboard
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="background:rgba(76,175,80,0.15); border:1px solid #4CAF50; color:#4CAF50; border-radius:12px;">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-error alert-dismissible fade show" role="alert">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.05); border-radius:20px; padding:20px;">
            <div class="table-responsive">
                <table class="table table-dark table-hover" style="border-color:rgba(255,255,255,0.05);">
                    <thead>
                        <tr>
                            <th><i class="fas fa-envelope"></i> Email</th>
                            <th><i class="fas fa-user"></i> Full Name</th>
                            <th><i class="fas fa-user-tag"></i> Role</th>
                            <th><i class="fas fa-circle"></i> Status</th>
                            <th><i class="fas fa-calendar"></i> Joined</th>
                            <th><i class="fas fa-cog"></i> Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.User.Email</td>
                                    <td>@item.User.FullName</td>
                                    <td>
                                        @if (item.Roles.Contains("Admin"))
                                        {
                                            <span class="badge-admin"><i class="fas fa-crown"></i> Admin</span>
                                        }
                                        else
                                        {
                                            <span class="badge-user"><i class="fas fa-user"></i> User</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="@(item.User.IsActive ? "badge-active" : "badge-inactive")">
                                            @(item.User.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td>@item.User.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div style="display:flex; flex-wrap:wrap; gap:4px;">
                                            <!-- Toggle Status -->
                                            <form asp-action="ToggleUserStatus" method="post" style="display:inline;">
                                                <input type="hidden" name="userId" value="@item.User.Id" />
                                                <button type="submit" class="action-btn @(item.User.IsActive ? "btn-delete" : "btn-edit")"
                                                        title="@(item.User.IsActive ? "Deactivate" : "Activate")">
                                                    <i class="fas @(item.User.IsActive ? "fa-pause-circle" : "fa-play-circle")"></i>
                                                    @(item.User.IsActive ? "Deactivate" : "Activate")
                                                </button>
                                            </form>

                                            <!-- Change Role -->
                                            @if (item.User.Email != "admin@egreetings.com")
                                            {
                                                @if (item.Roles.Contains("Admin"))
                                                {
                                                    <form asp-action="ChangeUserRole" method="post" style="display:inline;">
                                                        <input type="hidden" name="userId" value="@item.User.Id" />
                                                        <input type="hidden" name="role" value="User" />
                                                        <button type="submit" class="action-btn btn-remove-admin"
                                                                title="Remove Admin role" onclick="return confirm('Remove Admin role from this user?')">
                                                            <i class="fas fa-user"></i> Remove Admin
                                                        </button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <form asp-action="ChangeUserRole" method="post" style="display:inline;">
                                                        <input type="hidden" name="userId" value="@item.User.Id" />
                                                        <input type="hidden" name="role" value="Admin" />
                                                        <button type="submit" class="action-btn btn-make-admin"
                                                                title="Make Admin" onclick="return confirm('Make this user an Admin?')">
                                                            <i class="fas fa-crown"></i> Make Admin
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <span class="action-btn" style="background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.3); cursor:not-allowed;">
                                                    <i class="fas fa-lock"></i> Protected
                                                </span>
                                            }

                                            <!-- Delete User -->
                                            @if (item.User.Email != "admin@egreetings.com")
                                            {
                                                <form asp-action="DeleteUser" method="post" style="display:inline;">
                                                    <input type="hidden" name="userId" value="@item.User.Id" />
                                                    <button type="submit" class="action-btn btn-delete"
                                                            title="Delete User" onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone!')">
                                                        <i class="fas fa-trash-alt"></i> Delete
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="action-btn" style="background:rgba(255,255,255,0.1); color:rgba(255,255,255,0.3); cursor:not-allowed;">
                                                    <i class="fas fa-lock"></i> Protected
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center" style="color:rgba(255,255,255,0.3); padding:40px 0;">
                                    <i class="fas fa-users" style="font-size:2rem; display:block; margin-bottom:10px;"></i>
                                    No users found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
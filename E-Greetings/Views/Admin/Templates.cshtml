@model IEnumerable<Template>
@{
    ViewData["Title"] = "Manage Templates - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@keyframes gradientBG {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    @@keyframes floatBubble {
        0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.5; }
        50% { transform: translate(30px, -30px) scale(1.2); opacity: 1; }
    }

    .admin-section {
        position: relative;
        overflow: hidden;
        padding: 50px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .table-wrapper {
        background: rgba(255,255,255,0.02);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,0.04);
        border-radius: 20px;
        padding: 20px;
        overflow: hidden;
    }

    .table-custom {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        color: #FFFFFF;
    }

    .table-custom thead th {
        background: rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.4);
        font-weight: 600;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.03);
        text-align: left;
    }

    .table-custom tbody td {
        padding: 12px 16px;
        border-bottom: 1px solid rgba(255,255,255,0.02);
        color: rgba(255,255,255,0.7);
        vertical-align: middle;
    }

    .table-custom tbody tr:hover {
        background: rgba(255,255,255,0.02);
    }

    .table-custom tbody tr:last-child td {
        border-bottom: none;
    }

    .table-img {
        width: 44px;
        height: 44px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.04);
    }

    .btn-action {
        padding: 5px 12px;
        border: none;
        border-radius: 50px;
        font-size: 0.7rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
    }

    .btn-action:hover { transform: translateY(-2px); }

    .btn-action.edit { background: rgba(108,99,255,0.15); color: #6C63FF; border: 1px solid rgba(108,99,255,0.1); }
    .btn-action.edit:hover { background: rgba(108,99,255,0.25); }

    .btn-action.delete { background: rgba(255,107,107,0.15); color: #FF6B6B; border: 1px solid rgba(255,107,107,0.1); }
    .btn-action.delete:hover { background: rgba(255,107,107,0.25); }

    .btn-login {
        text-decoration: none;
        padding: 10px 25px;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        border: none;
        border-radius: 50px;
        color: #FFFFFF;
        font-weight: 600;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 40px rgba(108,99,255,0.2);
        color: #FFFFFF;
    }

    .btn-register {
        text-decoration: none;
        padding: 10px 25px;
        border: 2px solid rgba(255,255,255,0.2);
        border-radius: 50px;
        color: #FFFFFF;
        background: transparent;
        display: inline-block;
        transition: all 0.3s ease;
    }

    .btn-register:hover {
        border-color: rgba(255,255,255,0.4);
        color: #FFFFFF;
    }

    @@media (max-width: 768px) {
        .table-wrapper { padding: 12px; border-radius: 16px; }
        .table-custom thead th { font-size: 0.6rem; padding: 10px 10px; }
        .table-custom tbody td { padding: 10px 10px; font-size: 0.8rem; }
        .table-img { width: 32px; height: 32px; }
        .btn-action { padding: 3px 8px; font-size: 0.6rem; }
    }
</style>

<section class="admin-section">
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF; margin-bottom:0;">
                    Manage <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Templates</span>
                </h2>
                <p style="color:rgba(255,255,255,0.4);">Add, edit or remove templates</p>
            </div>
            <div>
                <a asp-action="AddTemplate" class="btn-login">
                    <i class="fas fa-plus"></i> Add Template
                </a>
                <a asp-action="Dashboard" class="btn-register" style="margin-left:10px;">
                    <i class="fas fa-home"></i> Dashboard
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="background:rgba(76,175,80,0.15); border:1px solid #4CAF50; color:#4CAF50; border-radius:12px;">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-wrapper">
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Image</th>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var template in Model)
                            {
                                <tr>
                                    <td><span style="color:#6C63FF; font-weight:600;">#@template.TemplateId</span></td>
                                    <td>
                                        <img src="@template.ImagePath" alt="@template.Title" class="table-img" 
                                             onerror="this.src='https://via.placeholder.com/44/1A1A2E/6C63FF?text=🎴'" />
                                    </td>
                                    <td><strong>@template.Title</strong></td>
                                    <td><span style="color:rgba(255,255,255,0.4);">@template.Category?.Name</span></td>
                                    <td style="color:rgba(255,255,255,0.3);">@template.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <div style="display:flex; gap:4px; flex-wrap:wrap;">
                                            <a asp-action="EditTemplate" asp-route-id="@template.TemplateId" class="btn-action edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <button onclick="deleteTemplate(@template.TemplateId)" class="btn-action delete">
                                                <i class="fas fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" style="text-align:center; color:rgba(255,255,255,0.2); padding:40px 0;">No templates found</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<form id="deleteForm" asp-action="DeleteTemplate" method="post" style="display:none;">
    <input type="hidden" id="deleteId" name="id" />
</form>

<script>
    function deleteTemplate(id) {
        if (confirm('Are you sure you want to delete this template?')) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteForm').submit();
        }
    }
</script>
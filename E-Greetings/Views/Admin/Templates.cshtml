@model IEnumerable<Template>
@{
    ViewData["Title"] = "Manage Templates - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .admin-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }
</style>

<section class="admin-section">
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF; margin-bottom:0;">
                    Manage <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Templates</span>
                </h2>
                <p style="color:rgba(255,255,255,0.4);">Add, edit or remove templates</p>
            </div>
            <div>
                <a asp-action="AddTemplate" class="btn btn-login" style="text-decoration:none; padding:10px 25px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600; display:inline-block;">
                    <i class="fas fa-plus"></i> Add Template
                </a>
                <a asp-action="Dashboard" class="btn btn-register" style="text-decoration:none; padding:10px 25px; border:2px solid rgba(255,255,255,0.2); border-radius:50px; color:#FFFFFF; background:transparent; display:inline-block; margin-left:10px;">
                    <i class="fas fa-home"></i> Dashboard
                </a>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="background:rgba(76,175,80,0.15); border:1px solid #4CAF50; color:#4CAF50; border-radius:12px;">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.05); border-radius:20px; padding:20px;">
            <div class="table-responsive">
                <table class="table table-dark table-hover" style="border-color:rgba(255,255,255,0.05);">
                    <thead>
                        <tr><th>ID</th><th>Image</th><th>Title</th><th>Category</th><th>Created</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var template in Model)
                            {
                                <tr>
                                    <td>#@template.TemplateId</td>
                                    <td><img src="@template.ImagePath" alt="@template.Title" style="width:50px; height:50px; object-fit:cover; border-radius:10px;" onerror="this.src='https://via.placeholder.com/50/1A1A2E/FFFFFF?text=🎴'" /></td>
                                    <td>@template.Title</td>
                                    <td>@template.Category?.Name</td>
                                    <td>@template.CreatedDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <a asp-action="EditTemplate" asp-route-id="@template.TemplateId" class="btn btn-sm btn-login" style="padding:5px 15px; text-decoration:none; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; display:inline-block;">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <button onclick="deleteTemplate(@template.TemplateId)" class="btn btn-sm btn-danger" style="padding:5px 15px; border:none; border-radius:50px; background:#FF6B6B; color:#FFFFFF; font-weight:600;">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center" style="color:rgba(255,255,255,0.3);">No templates found</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<form id="deleteForm" asp-action="DeleteTemplate" method="post" style="display:none;">
    <input type="hidden" id="deleteId" name="id" />
</form>

<script>
    function deleteTemplate(id) {
        if (confirm('Are you sure you want to delete this template?')) {
            document.getElementById('deleteId').value = id;
            document.getElementById('deleteForm').submit();
        }
    }
</script>
@model Card
@{
    ViewData["Title"] = "View Card - E-Greetings";
    Layout = null;
    var cardUrl = Url.Action("ViewCard", "Card", new { id = Model.CardId }, Context.Request.Scheme);
    var encodedUrl = Uri.EscapeDataString(cardUrl ?? "");
    var encodedMessage = Uri.EscapeDataString($"Hey! Check out this beautiful card from {Model.Sender?.FullName ?? "E-Greetings"}");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View Card - E-Greetings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #0F0F1A;
            min-height: 80vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 10px;
        }

        @@keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        @@keyframes floatBubble {
            0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.4; }
            50% { transform: translate(30px, -30px) scale(1.3); opacity: 0.8; }
        }

        @@keyframes fadeUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .view-wrapper {
            position: relative;
            width: 100%;
            max-width: 620px;
            margin: 0 auto;
        }

        .view-wrapper::before {
            content: '';
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            z-index: 0;
            background:
                radial-gradient(ellipse at 20% 30%, rgba(108,99,255,0.10) 0%, transparent 50%),
                radial-gradient(ellipse at 80% 70%, rgba(255,107,107,0.06) 0%, transparent 50%),
                linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 50%, #0F0F1A 100%);
            background-size: 400% 400%;
            animation: gradientBG 15s ease-in-out infinite;
            pointer-events: none;
        }

        .card-container {
            position: relative;
            z-index: 1;
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.04);
            border-radius: 32px;
            padding: 40px 36px;
            width: 100%;
            text-align: center;
            animation: fadeUp 0.7s ease forwards;
            box-shadow: 0 40px 100px rgba(0,0,0,0.3);
        }

        .card-container .sender {
            color: rgba(255,255,255,0.25);
            font-size: 0.8rem;
            letter-spacing: 0.5px;
        }

        .card-container .sender strong {
            color: #6C63FF;
            font-weight: 600;
        }

        .card-container .sender i {
            margin-right: 6px;
            color: #6C63FF;
        }

        .card-container .card-greeting {
            color: rgba(255,255,255,0.15);
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            margin-top: 12px;
        }

        .card-container h2 {
            color: #FFFFFF;
            font-weight: 700;
            font-size: 1.8rem;
            margin: 6px 0 10px;
            letter-spacing: -0.5px;
        }

        .card-container .message {
            color: rgba(255,255,255,0.55);
            font-size: 1rem;
            line-height: 1.8;
            margin: 12px 0 18px;
            font-style: italic;
            padding: 0 10px;
        }

        .card-container .card-image {
            width: 100%;
            border-radius: 20px;
            margin: 8px 0 18px;
            border: 1px solid rgba(255,255,255,0.04);
            max-height: 320px;
            object-fit: cover;
            transition: all 0.3s ease;
        }

        .card-container .card-image:hover {
            transform: scale(1.01);
            border-color: rgba(108,99,255,0.1);
        }

        .card-container .divider {
            border: none;
            border-top: 1px solid rgba(255,255,255,0.03);
            margin: 20px 0 18px;
        }

        .share-title {
            color: rgba(255,255,255,0.18);
            font-size: 0.65rem;
            letter-spacing: 2.5px;
            text-transform: uppercase;
            margin-bottom: 14px;
        }

        .share-title i {
            margin-right: 8px;
            color: #6C63FF;
        }

        .share-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin: 0 0 18px;
        }

        .share-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 5px;
            padding: 12px 8px;
            border-radius: 16px;
            border: 1px solid rgba(255,255,255,0.04);
            background: rgba(255,255,255,0.02);
            color: #FFFFFF;
            font-size: 0.65rem;
            font-weight: 500;
            transition: all 0.3s ease;
            cursor: pointer;
            text-decoration: none;
        }

        .share-btn i {
            font-size: 1.5rem;
            transition: all 0.3s ease;
        }

        .share-btn:hover {
            transform: translateY(-4px);
            border-color: rgba(255,255,255,0.08);
            background: rgba(255,255,255,0.04);
        }

        .share-btn.whatsapp:hover { border-color: #25D366; }
        .share-btn.whatsapp:hover i { color: #25D366; }

        .share-btn.facebook:hover { border-color: #1877F2; }
        .share-btn.facebook:hover i { color: #1877F2; }

        .share-btn.twitter:hover { border-color: #000000; }
        .share-btn.twitter:hover i { color: #000000; }

        .share-btn.linkedin:hover { border-color: #0A66C2; }
        .share-btn.linkedin:hover i { color: #0A66C2; }

        .share-btn.instagram:hover { border-color: #E4405F; }
        .share-btn.instagram:hover i { color: #E4405F; }

        .share-btn.copy-link:hover { border-color: #6C63FF; }
        .share-btn.copy-link:hover i { color: #6C63FF; }

        .share-btn .btn-label {
            font-size: 0.55rem;
            color: rgba(255,255,255,0.3);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .link-input-group {
            display: flex;
            gap: 10px;
            margin: 0 0 8px;
        }

        .link-input-group input {
            flex: 1;
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 12px;
            padding: 12px 16px;
            color: rgba(255,255,255,0.6);
            font-size: 0.85rem;
            outline: none;
            transition: all 0.3s ease;
        }

        .link-input-group input:focus {
            border-color: #6C63FF;
            background: rgba(255,255,255,0.05);
        }

        .link-input-group input::selection {
            background: rgba(108,99,255,0.2);
        }

        .link-input-group .btn-copy {
            padding: 12px 24px;
            background: linear-gradient(135deg, #6C63FF, #FF6B6B);
            border: none;
            border-radius: 12px;
            color: #FFFFFF;
            font-weight: 600;
            font-size: 0.9rem;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .link-input-group .btn-copy:hover {
            transform: scale(1.02);
            box-shadow: 0 10px 40px rgba(108,99,255,0.2);
        }

        .link-input-group .btn-copy.copied {
            background: #4CAF50;
        }

        .share-hint {
            color: rgba(255,255,255,0.15);
            font-size: 0.75rem;
            text-align: center;
            margin-top: 4px;
        }

        .share-hint i {
            margin-right: 6px;
        }

        .btn-group-view {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            justify-content: center;
            margin-top: 20px;
        }

        .btn-primary-view {
            padding: 12px 30px;
            background: linear-gradient(135deg, #6C63FF, #FF6B6B);
            border: none;
            border-radius: 50px;
            color: #FFFFFF;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            font-size: 0.9rem;
        }

        .btn-primary-view:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 40px rgba(108,99,255,0.3);
            color: #FFFFFF;
        }

        .btn-secondary-view {
            padding: 12px 30px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50px;
            color: rgba(255,255,255,0.5);
            background: transparent;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-block;
            font-size: 0.9rem;
        }

        .btn-secondary-view:hover {
            border-color: rgba(255,255,255,0.15);
            color: #FFFFFF;
        }

        .toast-msg {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%);
            background: linear-gradient(135deg, #6C63FF, #FF6B6B);
            color: #FFFFFF;
            padding: 12px 30px;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.9rem;
            opacity: 0;
            transition: opacity 0.4s ease;
            z-index: 999;
            box-shadow: 0 10px 40px rgba(108,99,255,0.3);
            letter-spacing: 0.3px;
        }

        .toast-msg.show {
            opacity: 1;
        }

        @@media (max-width: 600px) {
            .card-container {
                padding: 28px 18px;
                border-radius: 24px;
            }

            .card-container h2 {
                font-size: 1.4rem;
            }

            .card-container .message {
                font-size: 0.9rem;
            }

            .share-grid {
                grid-template-columns: repeat(2, 1fr);
                gap: 8px;
            }

            .link-input-group {
                flex-direction: column;
            }

            .link-input-group .btn-copy {
                width: 100%;
            }

            .btn-group-view {
                flex-direction: column;
                align-items: center;
            }

            .btn-primary-view, .btn-secondary-view {
                width: 100%;
                text-align: center;
            }
        }

        @@media (max-width: 400px) {
            .share-grid {
                grid-template-columns: 1fr 1fr;
                gap: 6px;
            }

            .share-btn {
                padding: 10px 6px;
                font-size: 0.55rem;
            }

            .share-btn i {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>

    <div class="view-wrapper">
        <div class="card-container">

            <!-- Sender - No Emoji -->
            <p class="sender">
                <i class="fas fa-heart"></i> Sent by <strong>@(Model.Sender?.FullName ?? "Anonymous")</strong>
            </p>

            <p class="card-greeting">A Special Message For You</p>

            <h2>Dear @Model.RecipientName,</h2>

            <p class="message">"@Model.Message"</p>

            <!-- Card Image -->
            <img src="@(!string.IsNullOrEmpty(Model.PhotoPath) ? Model.PhotoPath : Model.Template?.ImagePath)"
                 alt="Card"
                 class="card-image"
                 onerror="this.src='https://via.placeholder.com/600x400/1A1A2E/6C63FF?text=Greeting+Card'" />

            <hr class="divider" />

            <!-- Share Section -->
            <div class="share-title">
                <i class="fas fa-share-alt"></i> Share this card
            </div>

            <div class="share-grid">
                <a href="https://wa.me/?text=@encodedMessage%20@encodedUrl"
                   target="_blank" class="share-btn whatsapp">
                    <i class="fab fa-whatsapp"></i>
                    <span class="btn-label">WhatsApp</span>
                </a>

                <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
                   target="_blank" class="share-btn facebook">
                    <i class="fab fa-facebook-f"></i>
                    <span class="btn-label">Facebook</span>
                </a>

                <a href="https://twitter.com/intent/tweet?text=@encodedMessage&url=@encodedUrl"
                   target="_blank" class="share-btn twitter">
                    <i class="fab fa-twitter"></i>
                    <span class="btn-label">Twitter</span>
                </a>

                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
                   target="_blank" class="share-btn linkedin">
                    <i class="fab fa-linkedin-in"></i>
                    <span class="btn-label">LinkedIn</span>
                </a>

                <a href="https://www.instagram.com/"
                   target="_blank" class="share-btn instagram"
                   onclick="alert('Copy the link below and paste it in your Instagram DM or Story.')">
                    <i class="fab fa-instagram"></i>
                    <span class="btn-label">Instagram</span>
                </a>

                <button class="share-btn copy-link" onclick="copyLink()">
                    <i class="fas fa-link"></i>
                    <span class="btn-label">Copy Link</span>
                </button>
            </div>

            <!-- Link Input -->
            <div class="link-input-group">
                <input type="text" id="cardLinkInput" value="@cardUrl" readonly />
                <button class="btn-copy" id="copyBtn" onclick="copyLink()">
                    <i class="fas fa-copy"></i> Copy Link
                </button>
            </div>

            <p class="share-hint">
                <i class="fas fa-info-circle"></i> Anyone with this link can view your card
            </p>

            <!-- Buttons -->
            <div class="btn-group-view">
                <a asp-controller="Home" asp-action="Index" class="btn-secondary-view">
                    <i class="fas fa-home"></i> Home
                </a>
                <a asp-controller="Card" asp-action="MyCards" class="btn-secondary-view">
                    <i class="fas fa-history"></i> My Cards
                </a>
            </div>

        </div>
    </div>

    <!-- TOAST -->
    <div class="toast-msg" id="toastMsg">Link copied to clipboard</div>

    <script>
        function copyLink() {
            var input = document.getElementById('cardLinkInput');
            var copyBtn = document.getElementById('copyBtn');

            input.select();
            input.setSelectionRange(0, 99999);

            try {
                navigator.clipboard.writeText(input.value).then(function() {
                    copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                    copyBtn.classList.add('copied');
                    setTimeout(function() {
                        copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy Link';
                        copyBtn.classList.remove('copied');
                    }, 2500);
                });
            } catch (err) {
                document.execCommand('copy');
                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                copyBtn.classList.add('copied');
                setTimeout(function() {
                    copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy Link';
                    copyBtn.classList.remove('copied');
                }, 2500);
            }
        }
    </script>
</body>
</html>
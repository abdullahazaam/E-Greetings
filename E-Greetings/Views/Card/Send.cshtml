@model Card
@{
    ViewData["Title"] = "Send Card - E-Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .send-section {
        position: relative;
        overflow: hidden;
        padding: 50px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .form-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 30px;
        padding: 40px;
    }

    .form-control {
        background: rgba(255,255,255,0.05) !important;
        border: 1px solid rgba(255,255,255,0.1) !important;
        color: #FFFFFF !important;
        padding: 12px 16px;
        border-radius: 12px;
    }

        .form-control:focus {
            background: rgba(255,255,255,0.08) !important;
            border-color: #6C63FF !important;
            box-shadow: 0 0 0 3px rgba(108,99,255,0.2) !important;
            color: #FFFFFF !important;
        }

        .form-control::placeholder {
            color: rgba(255,255,255,0.3) !important;
        }

    .form-label {
        color: rgba(255,255,255,0.7);
        font-weight: 500;
    }

    .alert-info-custom {
        background: rgba(108,99,255,0.1);
        border: 1px solid rgba(108,99,255,0.2);
        color: #6C63FF;
        border-radius: 12px;
        padding: 15px 20px;
    }

        .alert-info-custom strong {
            color: #FFFFFF;
        }

    .preview-box {
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px;
        padding: 20px;
        margin: 20px 0;
        text-align: left;
    }

        .preview-box .label {
            color: rgba(255,255,255,0.3);
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .preview-box .value {
            color: #FFFFFF;
            font-size: 0.95rem;
            margin-top: 2px;
        }
</style>

<section class="send-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <!-- FLOATING BUBBLES -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="form-card">
                    <h2 style="color:#FFFFFF; font-weight:700; text-align:center;">
                        📤 Confirm &amp; <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Send</span>
                    </h2>
                    <p style="color:rgba(255,255,255,0.4); text-align:center; margin-bottom:20px;">
                        Review your card details and send it
                    </p>

                    <!-- Preview -->
                    <div class="preview-box">
                        <div class="label"><i class="fas fa-user"></i> Recipient</div>
                        <div class="value">@Model.RecipientName</div>
                        <div class="label mt-2"><i class="fas fa-envelope"></i> Email</div>
                        <div class="value">@Model.RecipientEmail</div>
                        <div class="label mt-2"><i class="fas fa-comment"></i> Message</div>
                        <div class="value" style="font-style:italic; color:rgba(255,255,255,0.5);">"@Model.Message"</div>
                        @if (Model.IsScheduled && Model.ScheduleDate.HasValue)
                        {
                            <div class="label mt-2"><i class="fas fa-clock" style="color:#FFD93D;"></i> Scheduled</div>
                            <div class="value" style="color:#FFD93D;">@Model.ScheduleDate.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                        }
                    </div>

                    <form asp-action="Send" method="post">
                        <input type="hidden" asp-for="CardId" />
                        <input type="hidden" asp-for="RecipientName" />
                        <input type="hidden" asp-for="RecipientEmail" />
                        <input type="hidden" asp-for="Message" />

                        <!-- Subject -->
                        <div class="mb-3">
                            <label asp-for="Subject" class="form-label">
                                <i class="fas fa-tag" style="color:#6C63FF;"></i> Subject
                            </label>
                            <input asp-for="Subject" class="form-control" placeholder="Happy Birthday!" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>

                        @if (Model.IsScheduled && Model.ScheduleDate.HasValue)
                        {
                            <div class="alert alert-info-custom">
                                <i class="fas fa-clock"></i> This card is scheduled for <strong style="color:#FFD93D;">@Model.ScheduleDate.Value.ToString("dd MMM yyyy, hh:mm tt")</strong>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info-custom">
                                <i class="fas fa-info-circle"></i> Your card will be sent to <strong>@Model.RecipientEmail</strong>
                            </div>
                        }

                        <button type="submit" class="btn btn-login" style="width:100%; padding:14px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600; transition:all 0.3s ease;">
                            <i class="fas fa-paper-plane"></i>
                            @if (Model.IsScheduled)
                            {
                                <span>Schedule Card</span>
                            }
                            else
                            {
                                <span>Send Card</span>
                            }
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-controller="Card" asp-action="Create" asp-route-templateId="@Model.TemplateId" class="btn btn-register" style="text-decoration:none; padding:8px 25px; border:2px solid rgba(255,255,255,0.2); border-radius:50px; color:#FFFFFF; background:transparent; display:inline-block;">
                            <i class="fas fa-arrow-left"></i> Back to Edit
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
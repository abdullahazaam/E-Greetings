@model IEnumerable<Card>
@{
    ViewData["Title"] = "My Cards - E-Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .mycards-section {
        position: relative;
        overflow: hidden;
        padding: 50px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .download-btn {
        padding: 5px 15px;
        border: none;
        border-radius: 50px;
        font-size: 0.75rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        color: #FFFFFF;
    }

        .download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(108, 99, 255, 0.3);
            color: #FFFFFF;
        }

    /* ✅ SCHEDULED BADGE */
    .badge-scheduled {
        background: #FFA94D;
        padding: 8px 15px;
        border-radius: 50px;
        color: #1A1A2E;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .badge-delivered {
        background: #4CAF50;
        padding: 8px 15px;
        border-radius: 50px;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.75rem;
    }

    .badge-pending {
        background: #FF6B6B;
        padding: 8px 15px;
        border-radius: 50px;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.75rem;
    }
</style>

<section class="mycards-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <!-- FLOATING BUBBLES -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="background:rgba(76,175,80,0.15); border:1px solid #4CAF50; color:#4CAF50; border-radius:12px;">
                <i class="fas fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="background:rgba(255,107,107,0.15); border:1px solid #FF6B6B; color:#FF6B6B; border-radius:12px;">
                <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="text-center" data-aos="fade-up">
            <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF;">
                My <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Cards</span>
            </h2>
            <p style="color:rgba(255,255,255,0.4);">Your sent card history</p>
        </div>

        <div class="row g-4 mt-3">
            @if (Model != null && Model.Any())
            {
                @foreach (var card in Model)
                {
                    <div class="col-lg-4 col-md-6" data-aos="fade-up">
                        <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(10px); padding:20px; border-radius:20px; border:1px solid rgba(255,255,255,0.05); transition:all 0.3s ease; height:100%;">
                            <img src="@card.Template?.ImagePath" alt="@card.Template?.Title"
                                 style="width:100%; height:180px; object-fit:cover; border-radius:15px;"
                                 onerror="this.src='https://via.placeholder.com/300x180/1A1A2E/FFFFFF?text=🎴'" />
                            <h5 class="mt-3" style="color:#FFFFFF; font-weight:600;">@card.RecipientName</h5>
                            <p style="color:rgba(255,255,255,0.3); font-size:0.85rem;">
                                <i class="fas fa-envelope"></i> @card.RecipientEmail
                            </p>
                            <p style="color:rgba(255,255,255,0.2); font-size:0.8rem;">
                                <i class="fas fa-calendar"></i>
                                @if (card.IsScheduled && card.ScheduleDate.HasValue)
                                {
                                    <span>Scheduled: @card.ScheduleDate.Value.ToString("dd MMM yyyy, hh:mm tt")</span>
                                }
                                else
                                {
                                    @card.SentDate.ToString("dd MMM yyyy")
                                }
                            </p>
                            <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px; flex-wrap:wrap; gap:5px;">
                                <!-- ✅ STATUS BADGE -->
                                @if (card.Status == "Scheduled")
                                {
                                    <span class="badge-scheduled">
                                        <i class="fas fa-clock"></i> Scheduled
                                    </span>
                                }
                                else if (card.Status == "Delivered")
                                {
                                    <span class="badge-delivered">
                                        <i class="fas fa-check-circle"></i> Delivered
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-pending">
                                        <i class="fas fa-hourglass-half"></i> @card.Status
                                    </span>
                                }

                                @if (card.Status == "Delivered")
                                {
                                    <a asp-controller="Card" asp-action="DownloadCard" asp-route-id="@card.CardId"
                                       class="download-btn">
                                        <i class="fas fa-download"></i> Download
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center" style="padding:80px 0;">
                    <i class="fas fa-envelope-open" style="font-size:4rem; color:rgba(255,255,255,0.1);"></i>
                    <h4 style="color:rgba(255,255,255,0.4); margin-top:20px;">No cards sent yet</h4>
                    <p style="color:rgba(255,255,255,0.2);">Start sending beautiful cards to your loved ones!</p>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-login" style="margin-top:20px; display:inline-block; padding:12px 40px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600; text-decoration:none; transition:all 0.3s ease;">
                        <i class="fas fa-plus"></i> Create a Card
                    </a>
                </div>
            }
        </div>
    </div>
</section>
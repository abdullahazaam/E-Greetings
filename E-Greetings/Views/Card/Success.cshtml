@model Card
@{
    ViewData["Title"] = "Card Sent! - E-Greetings";
    var cardUrl = Url.Action("ViewCard", "Card", new { id = Model.CardId }, Context.Request.Scheme);
    var encodedUrl = Uri.EscapeDataString(cardUrl ?? "");
    var encodedMessage = Uri.EscapeDataString($"Hey! Check out this beautiful card from {Model.Sender?.FullName ?? "E-Greetings"}");
}

<style>
    .success-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .success-card {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 30px;
        padding: 50px 40px;
        max-width: 550px;
        margin: 0 auto;
        text-align: center;
    }

    .success-icon {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 20px 60px rgba(108,99,255,0.25);
        animation: scaleIn 0.6s ease forwards;
    }

    .success-icon i {
        font-size: 2.8rem;
        color: #FFFFFF;
    }

    @@keyframes scaleIn {
        0% { transform: scale(0.7); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }

    .success-card h2 {
        color: #FFFFFF;
        font-weight: 700;
        font-size: 1.8rem;
        margin-bottom: 6px;
    }

    .success-card .sub-text {
        color: rgba(255,255,255,0.4);
        font-size: 0.95rem;
    }

    .success-card .sub-text strong {
        color: #6C63FF;
        font-weight: 600;
    }

    .success-card .card-id {
        color: rgba(255,255,255,0.12);
        font-size: 0.75rem;
        margin-top: 2px;
    }

    .success-card .divider {
        border: none;
        border-top: 1px solid rgba(255,255,255,0.04);
        margin: 25px 0;
    }

    .share-title {
        color: rgba(255,255,255,0.2);
        font-size: 0.7rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 14px;
    }

    .share-title i {
        margin-right: 6px;
        color: #6C63FF;
    }

    .share-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin: 0 0 20px;
    }

    .share-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 14px 10px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.04);
        background: rgba(255,255,255,0.02);
        color: #FFFFFF;
        font-size: 0.7rem;
        font-weight: 500;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
    }

    .share-btn i {
        font-size: 1.6rem;
        transition: all 0.3s ease;
    }

    .share-btn:hover {
        transform: translateY(-4px);
        border-color: rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.04);
    }

    .share-btn.whatsapp:hover { border-color: #25D366; }
    .share-btn.whatsapp:hover i { color: #25D366; }

    .share-btn.facebook:hover { border-color: #1877F2; }
    .share-btn.facebook:hover i { color: #1877F2; }

    .share-btn.twitter:hover { border-color: #000000; }
    .share-btn.twitter:hover i { color: #000000; }

    .share-btn.linkedin:hover { border-color: #0A66C2; }
    .share-btn.linkedin:hover i { color: #0A66C2; }

    .share-btn.instagram:hover { border-color: #E4405F; }
    .share-btn.instagram:hover i { color: #E4405F; }

    .share-btn.copy-link:hover { border-color: #6C63FF; }
    .share-btn.copy-link:hover i { color: #6C63FF; }

    .share-btn .btn-label {
        font-size: 0.6rem;
        color: rgba(255,255,255,0.3);
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .link-input-group {
        display: flex;
        gap: 10px;
        margin: 0 0 10px;
    }

    .link-input-group input {
        flex: 1;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 12px;
        padding: 12px 16px;
        color: rgba(255,255,255,0.6);
        font-size: 0.85rem;
        outline: none;
        transition: all 0.3s ease;
    }

    .link-input-group input:focus {
        border-color: #6C63FF;
        background: rgba(255,255,255,0.05);
    }

    .link-input-group input::selection {
        background: rgba(108,99,255,0.2);
    }

    .link-input-group .btn-copy {
        padding: 12px 24px;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        border: none;
        border-radius: 12px;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
        white-space: nowrap;
    }

    .link-input-group .btn-copy:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 40px rgba(108,99,255,0.2);
    }

    .link-input-group .btn-copy.copied {
        background: #4CAF50;
    }

    .share-hint {
        color: rgba(255,255,255,0.15);
        font-size: 0.75rem;
        text-align: center;
        margin-top: 6px;
    }

    .share-hint i {
        margin-right: 6px;
    }

    .btn-group-success {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
        margin-top: 22px;
    }

    .btn-primary-success {
        padding: 12px 30px;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        border: none;
        border-radius: 50px;
        color: #FFFFFF;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
        font-size: 0.9rem;
    }

    .btn-primary-success:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 40px rgba(108,99,255,0.3);
        color: #FFFFFF;
    }

    .btn-secondary-success {
        padding: 12px 30px;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 50px;
        color: rgba(255,255,255,0.5);
        background: transparent;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-block;
        font-size: 0.9rem;
    }

    .btn-secondary-success:hover {
        border-color: rgba(255,255,255,0.15);
        color: #FFFFFF;
    }

    .toast-msg {
        position: fixed;
        bottom: 30px;
        left: 50%;
        transform: translateX(-50%);
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        color: #FFFFFF;
        padding: 12px 30px;
        border-radius: 50px;
        font-weight: 600;
        opacity: 0;
        transition: opacity 0.4s ease;
        z-index: 999;
        box-shadow: 0 10px 40px rgba(108,99,255,0.3);
    }

    .toast-msg.show {
        opacity: 1;
    }

    @@media (max-width: 600px) {
        .success-card {
            padding: 30px 20px;
            margin: 0 10px;
        }

        .share-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .link-input-group {
            flex-direction: column;
        }

        .link-input-group .btn-copy {
            width: 100%;
        }

        .btn-group-success {
            flex-direction: column;
            align-items: center;
        }

        .btn-primary-success, .btn-secondary-success {
            width: 100%;
            text-align: center;
        }
    }

    @@media (max-width: 400px) {
        .share-grid {
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .share-btn {
            padding: 10px 6px;
            font-size: 0.6rem;
        }

        .share-btn i {
            font-size: 1.2rem;
        }
    }
</style>

<section class="success-section">
    <!-- BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <!-- FLOATING BUBBLES -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="success-card">

            <!-- ICON - No Emoji -->
            <div class="success-icon">
                <i class="fas fa-check-circle"></i>
            </div>

            <!-- CONGRATULATIONS - No Emoji -->
            <h2>Card Sent Successfully</h2>
            <p class="sub-text">
                Your card has been sent to <strong>@Model.RecipientEmail</strong>
            </p>
            <p class="card-id">Card ID: #@Model.CardId</p>

            @if (Model.IsScheduled && Model.ScheduleDate.HasValue)
            {
                <p style="color:#FFD93D; font-size:0.85rem; margin-top:4px;">
                    <i class="fas fa-clock"></i> Scheduled: @Model.ScheduleDate.Value.ToString("dd MMM yyyy, hh:mm tt")
                </p>
            }

            <hr class="divider" />

            <!-- SHARE -->
            <div class="share-title">
                <i class="fas fa-share-alt"></i> Share this card
            </div>

            <div class="share-grid">
                <a href="https://wa.me/?text=@encodedMessage%20@encodedUrl"
                   target="_blank" class="share-btn whatsapp">
                    <i class="fab fa-whatsapp"></i>
                    <span class="btn-label">WhatsApp</span>
                </a>

                <a href="https://www.facebook.com/sharer/sharer.php?u=@encodedUrl"
                   target="_blank" class="share-btn facebook">
                    <i class="fab fa-facebook-f"></i>
                    <span class="btn-label">Facebook</span>
                </a>

                <a href="https://twitter.com/intent/tweet?text=@encodedMessage&url=@encodedUrl"
                   target="_blank" class="share-btn twitter">
                    <i class="fab fa-twitter"></i>
                    <span class="btn-label">Twitter</span>
                </a>

                <a href="https://www.linkedin.com/sharing/share-offsite/?url=@encodedUrl"
                   target="_blank" class="share-btn linkedin">
                    <i class="fab fa-linkedin-in"></i>
                    <span class="btn-label">LinkedIn</span>
                </a>

                <a href="https://www.instagram.com/"
                   target="_blank" class="share-btn instagram"
                   onclick="alert('Copy the link below and paste it in your Instagram DM or Story.')">
                    <i class="fab fa-instagram"></i>
                    <span class="btn-label">Instagram</span>
                </a>

                <button class="share-btn copy-link" onclick="copyLink()">
                    <i class="fas fa-link"></i>
                    <span class="btn-label">Copy Link</span>
                </button>
            </div>

            <!-- LINK INPUT -->
            <div class="link-input-group">
                <input type="text" id="cardLinkInput" value="@cardUrl" readonly />
                <button class="btn-copy" id="copyBtn" onclick="copyLink()">
                    <i class="fas fa-copy"></i> Copy Link
                </button>
            </div>

            <p class="share-hint">
                <i class="fas fa-info-circle"></i> Anyone with this link can view your card
            </p>

            <!-- BUTTONS -->
            <div class="btn-group-success">
                <a asp-controller="Card" asp-action="ViewCard" asp-route-id="@Model.CardId" class="btn-primary-success" target="_blank">
                    <i class="fas fa-eye"></i> View Card
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn-secondary-success">
                    <i class="fas fa-home"></i> Home
                </a>
                <a asp-controller="Card" asp-action="MyCards" class="btn-secondary-success">
                    <i class="fas fa-history"></i> My Cards
                </a>
            </div>

        </div>
    </div>
</section>

<!-- TOAST -->
<div class="toast-msg" id="toastMsg">Link copied to clipboard</div>

<script>
    function copyLink() {
        var input = document.getElementById('cardLinkInput');
        var copyBtn = document.getElementById('copyBtn');

        input.select();
        input.setSelectionRange(0, 99999);

        try {
            navigator.clipboard.writeText(input.value).then(function() {
                copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
                copyBtn.classList.add('copied');
                setTimeout(function() {
                    copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy Link';
                    copyBtn.classList.remove('copied');
                }, 2500);
            });
        } catch (err) {
            document.execCommand('copy');
            copyBtn.innerHTML = '<i class="fas fa-check"></i> Copied!';
            copyBtn.classList.add('copied');
            setTimeout(function() {
                copyBtn.innerHTML = '<i class="fas fa-copy"></i> Copy Link';
                copyBtn.classList.remove('copied');
            }, 2500);
        }
    }
</script>
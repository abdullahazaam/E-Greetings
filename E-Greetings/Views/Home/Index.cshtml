﻿@{
ViewData["Title"] = "Home - Send Digital Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    @@keyframes floatCard {
        0%, 100% {
            transform: translateY(0px) rotate(0deg);
        }

        50% {
            transform: translateY(-15px) rotate(2deg);
        }
    }

    @@keyframes gradientMove {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes iconFloat {
        0%, 100% {
            transform: translateY(0) scale(1);
        }

        50% {
            transform: translateY(-8px) scale(1.1);
        }
    }

    @@keyframes shimmer {
        0% {
            background-position: -200% center;
        }

        100% {
            background-position: 200% center;
        }
    }

    .floating-cards {
        animation: floatCard 5s ease-in-out infinite;
    }

    /* ===== HERO SECTION - SIMPLE & CLEAN ===== */
    .hero-section {
        position: relative;
        overflow: hidden;
        min-height: 90vh;
        display: flex;
        align-items: center;
        padding: 80px 0;
        background: #0F0F1A;
    }

    .gradient-text {
        background: linear-gradient(135deg, #6C63FF, #FF6B6B, #FFD93D);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-size: 300% 300%;
        animation: gradientMove 5s ease-in-out infinite;
    }

    .btn-hero {
        display: inline-block;
        padding: 16px 48px;
        background: linear-gradient(135deg, #6C63FF, #FF6B6B);
        border: none;
        border-radius: 50px;
        color: #FFFFFF;
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-hero:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 50px rgba(108, 99, 255, 0.4);
            color: #FFFFFF;
        }

    /* ===== CATEGORY SECTION - ADVANCED GLASSMORPHISM ===== */
    .category-section {
        padding: 80px 0;
        background: #141425;
        position: relative;
        overflow: hidden;
    }

        .category-section::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(ellipse at 30% 50%, rgba(108, 99, 255, 0.05) 0%, transparent 60%), radial-gradient(ellipse at 70% 50%, rgba(255, 107, 107, 0.05) 0%, transparent 60%);
            animation: gradientBG 20s ease-in-out infinite;
            z-index: 0;
        }

    .category-card-new {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 24px;
        padding: 35px 20px 30px;
        text-align: center;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        cursor: pointer;
        position: relative;
        overflow: hidden;
        z-index: 1;
        height: 100%;
        min-height: 260px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .category-card-new::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(108, 99, 255, 0.08), rgba(255, 107, 107, 0.08));
            opacity: 0;
            transition: opacity 0.5s ease;
            border-radius: 24px;
            z-index: -1;
        }

        .category-card-new::after {
            content: '';
            position: absolute;
            top: -2px;
            left: -2px;
            right: -2px;
            bottom: -2px;
            background: linear-gradient(135deg, #6C63FF, #FF6B6B, #6C63FF);
            background-size: 300% 300%;
            border-radius: 26px;
            opacity: 0;
            transition: opacity 0.5s ease;
            z-index: -2;
            animation: shimmer 3s ease-in-out infinite;
        }

        .category-card-new:hover::before {
            opacity: 1;
        }

        .category-card-new:hover::after {
            opacity: 0.3;
        }

        .category-card-new:hover {
            transform: translateY(-12px) scale(1.02);
            border-color: rgba(108, 99, 255, 0.3);
            box-shadow: 0 25px 60px rgba(108, 99, 255, 0.15);
        }

        .category-card-new .icon-wrap {
            font-size: 3.5rem;
            display: block;
            margin-bottom: 15px;
            transition: all 0.4s ease;
            animation: iconFloat 4s ease-in-out infinite;
            position: relative;
            color: #6C63FF;
        }

        .category-card-new:hover .icon-wrap {
            transform: scale(1.15) rotate(-5deg);
            animation: none;
            color: #FF6B6B;
        }

        .category-card-new .icon-wrap .icon-bg {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: rgba(108, 99, 255, 0.08);
            z-index: -1;
            transition: all 0.5s ease;
        }

        .category-card-new:hover .icon-wrap .icon-bg {
            width: 100px;
            height: 100px;
            background: rgba(108, 99, 255, 0.15);
        }

        .category-card-new h5 {
            font-weight: 700;
            font-size: 1.3rem;
            color: #FFFFFF;
            margin-bottom: 5px;
        }

        .category-card-new .template-count {
            color: rgba(255, 255, 255, 0.35);
            font-size: 0.85rem;
            margin-bottom: 12px;
        }

        .category-card-new .view-link {
            color: #6C63FF;
            font-weight: 500;
            font-size: 0.9rem;
            text-decoration: none;
            transition: all 0.3s ease;
            opacity: 0.7;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .category-card-new:hover .view-link {
            opacity: 1;
            gap: 12px;
            color: #FF6B6B;
        }

            .category-card-new:hover .view-link i {
                transform: translateX(4px);
            }

        .category-card-new .glow {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at center, rgba(108, 99, 255, 0.03) 0%, transparent 70%);
            opacity: 0;
            transition: opacity 0.6s ease;
            pointer-events: none;
        }

        .category-card-new:hover .glow {
            opacity: 1;
        }

    @@media (max-width: 768px) {
        .category-card-new {
            min-height: 200px;
            padding: 25px 15px;
        }

            .category-card-new .icon-wrap {
                font-size: 2.5rem;
            }

            .category-card-new h5 {
                font-size: 1.1rem;
            }
    }
</style>

<!-- ===== HERO SECTION - SIMPLE & CLEAN ===== -->
<section class="hero-section">

    <!-- GRADIENT BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <!-- FLOATING BUBBLES -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:250px; height:250px; border-radius:50%; background:rgba(108,99,255,0.06); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:350px; height:350px; border-radius:50%; background:rgba(255,107,107,0.04); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:150px; height:150px; border-radius:50%; background:rgba(255,217,61,0.03); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-up">
                <h1 style="font-size:4.5rem; font-weight:800; line-height:1.1; color:#FFFFFF;">
                    Send <span class="gradient-text">Digital</span> <br />
                    Greetings <span class="gradient-text">Instantly</span>
                </h1>
                <p style="color: rgba(255,255,255,0.7); font-size:1.2rem; max-width:500px; margin:25px 0; line-height:1.8;">
                    Choose from hundreds of beautiful e-cards, personalize with your message,
                    photo or video, and deliver to your loved ones in seconds.
                </p>
                <a href="/Category/Index" class="btn-hero">
                    <i class="fas fa-rocket"></i> Get Started Free
                </a>
                <div class="mt-4">
                    <small style="color: rgba(255,255,255,0.3);">
                        <i class="fas fa-check-circle" style="color: #6C63FF;"></i> No credit card required
                        &nbsp;&nbsp;
                        <i class="fas fa-check-circle" style="color: #6C63FF;"></i> 10k+ happy users
                    </small>
                </div>
            </div>
            <div class="col-lg-6 text-center floating-cards" data-aos="fade-left">
                <img src="~/img/Baloon.jpg"
                     class="img-fluid rounded-4 shadow-lg"
                     alt="E-Cards Preview"
                     style="border: 1px solid rgba(255,255,255,0.05); width:100%; max-width:500px; border-radius:20px;"
                     onerror="this.src='https://images.unsplash.com/photo-1530103862676-de8c9debad1d?w=550&h=420&fit=crop'" />
            </div>
        </div>
    </div>
</section>

<!-- ===== CATEGORIES SECTION - ADVANCED GLASSMORPHISM ===== -->
<section class="category-section">
    <div class="container" style="position:relative; z-index:1;">
        <div class="text-center" data-aos="fade-up">
            <h2 style="font-size:2.8rem; font-weight:700; margin-bottom:10px; color:#FFFFFF;">
                Choose Your <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Category</span>
            </h2>
            <p style="color:rgba(255,255,255,0.4); font-size:1.1rem; margin-bottom:50px;">

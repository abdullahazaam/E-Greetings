            </div>

            <!-- Wedding -->
            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <a href="/Category/Details/2" style="text-decoration:none; display:block; height:100%;">
                    <div class="category-card-new">
                        <div class="glow"></div>
                        <div class="icon-wrap">
                            <span class="icon-bg"></span>
                            <i class="fas fa-ring"></i>
                        </div>
                        <h5>Wedding</h5>
                        <p class="template-count">85+ Templates</p>

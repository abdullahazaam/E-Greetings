                            Explore <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <!-- New Year -->
            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <a href="/Category/Details/3" style="text-decoration:none; display:block; height:100%;">
                    <div class="category-card-new">
                        <div class="glow"></div>
                        <div class="icon-wrap">
                            <span class="icon-bg"></span>
                            <i class="fas fa-calendar-alt"></i>
                        </div>
                        <h5>New Year</h5>
                        <p class="template-count">60+ Templates</p>
                        <span class="view-link">
                            Explore <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>

            <!-- Festivals -->
            <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <a href="/Category/Details/4" style="text-decoration:none; display:block; height:100%;">
                    <div class="category-card-new">
                        <div class="glow"></div>
                        <div class="icon-wrap">
                            <span class="icon-bg"></span>
                            <i class="fas fa-gift"></i>
                        </div>
                        <h5>Festivals</h5>
                        <p class="template-count">45+ Templates</p>
                        <span class="view-link">
                            Explore <i class="fas fa-arrow-right"></i>
                        </span>
                    </div>
                </a>
            </div>
        </div>
    </div>
</section>
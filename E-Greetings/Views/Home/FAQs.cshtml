@{
    ViewData["Title"] = "FAQs - E-Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .faq-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }

    .faq-item {
        background: rgba(255,255,255,0.03);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 16px;
        padding: 25px 30px;
        margin-bottom: 20px;
        transition: all 0.3s ease;
        cursor: pointer;
    }

        .faq-item:hover {
            border-color: rgba(108,99,255,0.3);
            background: rgba(255,255,255,0.05);
        }

        .faq-item h5 {
            color: #FFFFFF;
            font-weight: 600;
            margin-bottom: 8px;
        }

            .faq-item h5 i {
                color: #6C63FF;
                margin-right: 10px;
            }

        .faq-item p {
            color: rgba(255,255,255,0.5);
            margin-bottom: 0;
            padding-left: 30px;
            line-height: 1.8;
        }
</style>

<section class="faq-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="text-center" data-aos="fade-up">
            <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF; margin-bottom:10px;">
                Frequently Asked <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Questions</span>
            </h2>
            <p style="color:rgba(255,255,255,0.4); font-size:1.1rem;">Find answers to common questions about E-Greetings</p>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-8">

                <div class="faq-item" data-aos="fade-up" data-aos-delay="100">
                    <h5><i class="fas fa-question-circle"></i> What is E-Greetings?</h5>
                    <p>E-Greetings is a digital card sending platform that allows users to create, personalize, and send beautiful e-cards to their loved ones via email.</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="150">
                    <h5><i class="fas fa-question-circle"></i> How do I create an account?</h5>
                    <p>Click on the "Register" button on the top right corner, fill in your details, and you're ready to start sending cards!</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="200">
                    <h5><i class="fas fa-question-circle"></i> How do I send a card?</h5>
                    <p>Browse through categories, select a template, personalize it with your message, add recipient email, and click "Send Card".</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="250">
                    <h5><i class="fas fa-question-circle"></i> Is E-Greetings free?</h5>
                    <p>Yes! We offer a free plan that allows you to send 5 cards per month. For unlimited cards and daily delivery, check out our Premium plan.</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="300">
                    <h5><i class="fas fa-question-circle"></i> How does the subscription work?</h5>
                    <p>Subscribe to our Premium plan for $9.99/month to get unlimited cards, all templates, daily delivery to 10+ emails, and priority support.</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="350">
                    <h5><i class="fas fa-question-circle"></i> Can I cancel my subscription?</h5>
                    <p>Yes, you can cancel your subscription anytime from your profile settings. No hidden charges.</p>
                </div>

                <div class="faq-item" data-aos="fade-up" data-aos-delay="400">
                    <h5><i class="fas fa-question-circle"></i> How do I contact support?</h5>
                    <p>You can reach us via the "Contact Us" page in the Help section or email us at support@egreetings.com.</p>
                </div>

                <div class="text-center mt-4">
                    <a asp-controller="Home" asp-action="HelpCenter" class="btn btn-register" style="padding:12px 35px; border:2px solid rgba(255,255,255,0.2); border-radius:50px; color:#FFFFFF; background:transparent; text-decoration:none; display:inline-block;">
                        <i class="fas fa-arrow-left"></i> Back to Help Center
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-login" style="padding:12px 35px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600; text-decoration:none; display:inline-block; margin-left:10px;">
                        <i class="fas fa-home"></i> Home
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
﻿@{
ViewData["Title"] = "Privacy Policy - E-Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .privacy-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }
</style>

<section class="privacy-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <!-- FLOATING BUBBLES -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
        <div style="position:absolute; top:50%; left:40%; width:120px; height:120px; border-radius:50%; background:rgba(255,217,61,0.05); animation: floatBubble 12s ease-in-out infinite 4s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="text-center" data-aos="fade-up">
            <h2 style="font-size:2.8rem; font-weight:700; color:#FFFFFF; margin-bottom:10px;">
                Privacy <span style="background:linear-gradient(135deg, #6C63FF, #FF6B6B); -webkit-background-clip:text; -webkit-text-fill-color:transparent;">Policy</span>
            </h2>
            <p style="color:rgba(255,255,255,0.4); font-size:1.1rem;">How we protect your data</p>
        </div>

        <div class="row justify-content-center mt-4">
            <div class="col-lg-8">
                <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.05); border-radius:30px; padding:40px;">
                    <h4 style="color:#FFFFFF; font-weight:600;"><i class="fas fa-database" style="color:#6C63FF;"></i> 1. Information We Collect</h4>
                    <p style="color:rgba(255,255,255,0.6); line-height:1.8;">We collect personal information such as name, email address, and preferences when you create an account.</p>

                    <h4 style="color:#FFFFFF; font-weight:600; margin-top:30px;"><i class="fas fa-cogs" style="color:#6C63FF;"></i> 2. How We Use Your Information</h4>
                    <p style="color:rgba(255,255,255,0.6); line-height:1.8;">We use your information to send cards, improve our services, and communicate with you.</p>

                    <h4 style="color:#FFFFFF; font-weight:600; margin-top:30px;"><i class="fas fa-shield-alt" style="color:#6C63FF;"></i> 3. Data Security</h4>
                    <p style="color:rgba(255,255,255,0.6); line-height:1.8;">We implement security measures to protect your personal information.</p>

                    <h4 style="color:#FFFFFF; font-weight:600; margin-top:30px;"><i class="fas fa-envelope" style="color:#6C63FF;"></i> 4. Contact Us</h4>
                    <p style="color:rgba(255,255,255,0.6); line-height:1.8;">If you have questions about this policy, please contact us at <strong style="color:#6C63FF;">support@egreetings.com</strong></p>

                    <div class="mt-4 text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-login" style="padding:12px 40px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600; text-decoration:none; display:inline-block;">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
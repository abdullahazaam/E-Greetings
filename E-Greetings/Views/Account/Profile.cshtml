@model User
@{
    ViewData["Title"] = "My Profile - E-Greetings";
}

<style>
    @@keyframes gradientBG {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    @@keyframes floatBubble {
        0%, 100% {
            transform: translate(0, 0) scale(1);
            opacity: 0.5;
        }

        50% {
            transform: translate(30px, -30px) scale(1.2);
            opacity: 1;
        }
    }

    .profile-section {
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
        min-height: 80vh;
        background: #0F0F1A;
    }
</style>

<section class="profile-section">
    <!-- ANIMATED BACKGROUND -->
    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0;
                background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
                background-size: 400% 400%;
                animation: gradientBG 12s ease-in-out infinite;">
    </div>

    <div style="position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; overflow:hidden;">
        <div style="position:absolute; top:10%; left:5%; width:200px; height:200px; border-radius:50%; background:rgba(108,99,255,0.08); animation: floatBubble 8s ease-in-out infinite;"></div>
        <div style="position:absolute; bottom:15%; right:5%; width:300px; height:300px; border-radius:50%; background:rgba(255,107,107,0.06); animation: floatBubble 10s ease-in-out infinite 2s;"></div>
    </div>

    <div class="container" style="position:relative; z-index:1;">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div style="background:rgba(255,255,255,0.03); backdrop-filter:blur(10px); border:1px solid rgba(255,255,255,0.05); border-radius:30px; padding:40px;">
                    <div class="text-center mb-4">
                        <div style="width:80px; height:80px; border-radius:50%; background:linear-gradient(135deg, #6C63FF, #FF6B6B); display:flex; align-items:center; justify-content:center; margin:0 auto 15px;">
                            <i class="fas fa-user" style="font-size:2.5rem; color:#FFFFFF;"></i>
                        </div>
                        <h2 style="color:#FFFFFF; font-weight:700;">My Profile</h2>
                        <p style="color:rgba(255,255,255,0.4);">Manage your account information</p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert" style="background:rgba(76,175,80,0.15); border:1px solid #4CAF50; color:#4CAF50; border-radius:12px;">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label" style="color:rgba(255,255,255,0.7);">Full Name</label>
                            <input asp-for="FullName" class="form-control" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#FFFFFF; padding:12px; border-radius:12px;" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label" style="color:rgba(255,255,255,0.7);">Email Address</label>
                            <input asp-for="Email" class="form-control" style="background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.1); color:#FFFFFF; padding:12px; border-radius:12px;" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="color:rgba(255,255,255,0.7);">Account Created</label>
                            <input value="@Model.CreatedDate.ToString("dd MMM yyyy, hh:mm tt")" class="form-control" disabled style="background:rgba(255,255,255,0.03); border:1px solid rgba(255,255,255,0.05); color:rgba(255,255,255,0.3); padding:12px; border-radius:12px;" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" style="color:rgba(255,255,255,0.7);">Status</label>
                            <span class="badge" style="background:@(Model.IsActive ? "#4CAF50" : "#FF6B6B"); padding:8px 20px; border-radius:50px;">@(Model.IsActive ? "Active" : "Inactive")</span>
                        </div>

                        <button type="submit" class="btn btn-login" style="width:100%; padding:14px; background:linear-gradient(135deg, #6C63FF, #FF6B6B); border:none; border-radius:50px; color:#FFFFFF; font-weight:600;">
                            <i class="fas fa-save"></i> Update Profile
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-register" style="text-decoration:none; padding:10px 30px; border:2px solid rgba(255,255,255,0.2); border-radius:50px; color:#FFFFFF; background:transparent; display:inline-block;">
                            <i class="fas fa-home"></i> Back to Home
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
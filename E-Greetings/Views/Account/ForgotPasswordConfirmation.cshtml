@{
    ViewData["Title"] = "Forgot Password - E-Greetings";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Password Reset Email Sent - E-Greetings</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />
    <style>
        @@keyframes gradientBG {
            0% {
                background-position: 0% 50%;
            }

            50% {
                background-position: 100% 50%;
            }

            100% {
                background-position: 0% 50%;
            }
        }

        @@keyframes floatBubble {
            0%, 100% {
                transform: translate(0, 0) scale(1);
                opacity: 0.5;
            }

            50% {
                transform: translate(30px, -30px) scale(1.2);
                opacity: 1;
            }
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background: #0F0F1A;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            overflow: hidden;
        }

        .bg-gradient {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #0F0F1A 0%, #1A0A2E 25%, #2A0A3E 50%, #1A0A2E 75%, #0F0F1A 100%);
            background-size: 400% 400%;
            animation: gradientBG 12s ease-in-out infinite;
            z-index: 0;
        }

        .bubbles {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            overflow: hidden;
        }

            .bubbles div {
                position: absolute;
                border-radius: 50%;
                background: rgba(108,99,255,0.06);
                animation: floatBubble 8s ease-in-out infinite;
            }

                .bubbles div:nth-child(1) {
                    top: 10%;
                    left: 5%;
                    width: 200px;
                    height: 200px;
                }

                .bubbles div:nth-child(2) {
                    bottom: 15%;
                    right: 5%;
                    width: 300px;
                    height: 300px;
                    animation-delay: 2s;
                }

        .card-container {
            position: relative;
            z-index: 1;
            background: rgba(255,255,255,0.03);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 30px;
            padding: 50px 40px;
            max-width: 450px;
            width: 100%;
            text-align: center;
        }

            .card-container .icon {
                font-size: 4rem;
                color: #6C63FF;
            }

            .card-container h2 {
                color: #FFFFFF;
                font-weight: 700;
                margin-top: 15px;
            }

            .card-container p {
                color: rgba(255,255,255,0.6);
            }

        .btn-login {
            background: linear-gradient(135deg, #6C63FF, #FF6B6B);
            border: none;
            padding: 12px 40px;
            border-radius: 50px;
            color: #FFFFFF;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 40px rgba(108,99,255,0.3);
                color: #FFFFFF;
            }
    </style>
</head>
<body>
    <div class="bg-gradient"></div>
    <div class="bubbles">
        <div></div><div></div>
    </div>

    <div class="card-container">
        <div class="icon"><i class="fas fa-envelope"></i></div>
        <h2>Check Your Email</h2>
        <p>We have sent a password reset link to your email address. Please check your inbox.</p>
        <p style="color:rgba(255,255,255,0.3); font-size:0.9rem;">Didn't receive the email? Check your spam folder.</p>
        <a asp-action="Login" class="btn-login mt-3">
            <i class="fas fa-arrow-left"></i> Back to Login
        </a>
    </div>
</body>
</html>